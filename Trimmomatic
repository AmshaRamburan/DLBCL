#!/bin/bash
#SBATCH --account ibms
#SBATCH --partition=ada
#SBATCH --time=10:00:00
#SBATCH --nodes=1 --ntasks=6
#SBATCH --job-name="Trimmomatic"
#SBATCH --mail-user=amsha.ramburan@uct.ac.za
#SBATCH --mail-type=ALL

# Load Trimmomatic module
module load software/Trimmomatic-0.40-rc1 || 

# Define paths
adapters="/scratch/01456151/adapters.fasta"
input_dir="/scratch/01456151/rawdata/"
output_dir="/scratch/01456151/trim/"
trimmomatic_jar="/opt/exp_soft/Trimmomatic-0.40-rc1/trimmomatic-0.40-rc1.jar"

# Check if Trimmomatic JAR exists
if [[ ! -f "$trimmomatic_jar" ]]; then
    echo "Error: Trimmomatic JAR not found at $trimmomatic_jar"
    exit 1
fi

# Define specific list of file base names (without _1.fq/_2.fq suffix)
samples=(
    14716_17
)
# Loop over specified samples
for sample in "${samples[@]}"; do
  file1="${input_dir}${sample}_1.fq"
  file2="${input_dir}${sample}_2.fq"
  # Ensure both files exist
  if [[ -f "$file1" && -f "$file2" ]]; then
    echo "Processing sample: $sample"
    
    java -jar "$trimmomatic_jar" \
      PE -phred33 "$file1" "$file2" \
      "${output_dir}output_${sample}_1.fq" "${output_dir}unpaired_${sample}_1.fq" \
      "${output_dir}output_${sample}_2.fq" "${output_dir}unpaired_${sample}_2.fq" \
      ILLUMINACLIP:$adapters:2:20:10 \
      LEADING:3 \
      TRAILING:3 \
      SLIDINGWINDOW:4:15 \
      MINLEN:25
  else
    echo "Warning: One or both input files not found for sample $sample, skipping."
  fi
done
