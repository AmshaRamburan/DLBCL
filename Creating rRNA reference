#!/bin/bash
#SBATCH --account ibms
#SBATCH --partition=ada
#SBATCH --time=10:00:00
#SBATCH --nodes=1 --ntasks=4
#SBATCH --job-name="extract_rRNA"
#SBATCH --mail-user=amsha.ramburan@uct.ac.za
#SBATCH --mail-type=ALL

module load software/bedtools-2.31.0

# Input paths
GTF="/scratch/01456151/Homo_sapiens.GRCh38.114.gtf"
FASTA="/scratch/01456151/Homo_sapiens.GRCh38.dna.primary_assembly.fa"

# Output paths
BED="rRNA.bed"
OUT_FASTA="rRNA_reference.fa"

# Extract rRNA genes into BED format
awk '$3 == "gene" && $0 ~ /gene_biotype "rRNA"/ {
    match($9, /gene_id "([^"]+)"/, a);
    print $1 "\t" ($4-1) "\t" $5 "\t" a[1] "\t.\t" $7
}' "$GTF" > "$BED"

# Check if any entries were found
if [[ ! -s "$BED" ]]; then
    echo "? No rRNA genes found in GTF."
    exit 1
fi

# Extract rRNA sequences using bedtools
bedtools getfasta -fi "$FASTA" -bed "$BED" -s -name -fo "$OUT_FASTA"

echo "Extracted rRNA reference written to: $OUT_FASTA"
